<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Google Play Billing. Biblioteca (com.android.billingclient, adusa de
         in_app_purchase) o declara si ea in manifestul propriu, deci ar merge
         si fara linia asta - dar atunci permisiunea apare in APK "de nicaieri".
         Aici e explicita si documentata. Vezi lib/data/iap_service.dart. -->
    <uses-permission android:name="com.android.vending.BILLING"/>

    <!-- Notificari pe telefon (vezi lib/data/device_notification_service.dart).
         POST_NOTIFICATIONS e ceruta de la Android 13 incolo si trebuie ceruta
         SI la rulare, nu doar declarata aici.
         SCHEDULE_EXACT_ALARM: notificarile noastre sunt legate de momente
         exacte (roata s-a resetat la fix 24h de la ultimul spin, planeta la
         fix 12h). Fara ea, Android amana declansarea cu zeci de minute ca sa
         economiseasca bateria. Se cere si la rulare; daca userul o refuza,
         DeviceNotificationService._schedule cade pe programare inexacta.
         USE_EXACT_ALARM a fost SCOASA pe 2026-09-10: Google Play o permite
         doar aplicatiilor de ceas desteptator/calendar, deci un joc care o
         declara risca respingerea la review. Nu adauga nimic fata de
         SCHEDULE_EXACT_ALARM + rezerva inexacta de mai sus.
         RECEIVE_BOOT_COMPLETED: alarmele programate se pierd la repornirea
         telefonului; cu ea, pluginul le reprogrameaza singur. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <application
        android:label="SodoQuizz"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Link de invitație prieteni: guessit://addfriend/<cod> — schemă
                 proprie, nu Android App Link, ca să nu ceară assetlinks.json
                 găzduit pe GH Pages (vezi docs/build.md). Ținta e citită în
                 main.dart, GuessItApp._listenForDeepLinks, cu pachetul app_links. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="guessit" android:host="addfriend"/>
            </intent-filter>
            <!-- Link de "Provoacă un prieten": guessit://challenge/<cod>. Fără
                 asta, Android nu are deloc cui să dea tap-ul pe link — codul
                 scris de mână era singura cale care mergea (bug găsit
                 2026-09-18). Ținta: main.dart, _handleDeepLink. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="guessit" android:host="challenge"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- FLAG MORT din Flutter 3.44+ (mai 2026): Skia a fost eliminat de
             pe Android 10+, Impeller/Vulkan e acum obligatoriu — acest
             meta-data e ignorat, orice valoare ai pune aici. Verificat live
             2026-09-10: cu "false" aici, bug-ul de ecran negru la login
             Google (vezi mai jos) s-a reprodus IDENTIC — deci flag-ul nu mai
             ține. Confirmat și din sursa Flutter (dev blog/GitHub): "the
             opt-out through EnableImpeller is deprecated and going away".
             Rămâne pe "true" doar ca să nu sugereze cuiva că "false" ar
             rezolva ceva — nu rezolvă, pe versiunea asta de Flutter.
             ISTORIC: renderer-ul Impeller (Vulkan) pierde suprafața de
             desen pe GPU-uri Samsung Xclipse când aplicația e readusă în
             față de o Activitate externă (fereastra Google e cazul confirmat
             de mine). Simptom: ecran negru complet, dar audio continuă
             (motorul trăiește, doar desenul moare); logcat curat, nicio
             excepție. NU exista fix la nivel de cod Dart găsit până acum —
             vezi [[project_guess_it_impeller_blackscreen_bug]]. Singura
             recuperare: repornire completă (`adb shell am force-stop
             com.dragosssx.guessit` + relansare). -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="true" />
        <!-- Impeller pe OpenGL ES, NU pe Vulkan (2026-09-11). Bug-ul de ecran
             negru la revenirea din fereastra Google e în backend-ul Vulkan pe
             GPU-uri Samsung Xclipse. Flutter 3.47 nu mai permite oprirea
             Impeller, dar încă citește cheia asta (verificat în flutter.jar,
             FlutterEngineFlags: cheia "ImpellerBackend" devine flag-ul de motor
             impeller-backend). Atenție: în comentariile XML nu au voie două
             liniuțe la rând, altfel manifestul nu se mai parsează.
             Downgrade-ul la 3.27.4 NU e posibil: in_app_purchase_android 0.5.x
             (plățile reale) cere Dart 3.12 = Flutter 3.44+. -->
        <meta-data
            android:name="io.flutter.embedding.android.ImpellerBackend"
            android:value="opengles" />
        <!-- AdMob App ID real, din consola AdMob (app "Sodo Quizz"). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7925849908413802~7115439770"/>
        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/game_services_project_id"/>
        <meta-data
            android:name="com.chunkytofustudios.firebase_auth_games_services.OAUTH_2_WEB_CLIENT_ID"
            android:value="@string/firebase_auth_oauth_2_web_client_id"/>

        <!-- Canalul implicit pentru orice notificare push care ar ajunge totusi
             ca `notification` de sistem (nu ar trebui - Functions trimit
             data-only - dar daca se intampla, sa foloseasca canalul nostru cu
             sunetul propriu, nu unul generat de Android). ID-ul TREBUIE sa fie
             exact cel din DeviceNotificationService._channelId. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="sodo_events_v1"/>

        <!-- Pluginul de notificari locale: primeste alarma programata si
             afiseaza notificarea chiar daca aplicatia e inchisa. Al doilea
             receiver le pune la loc dupa o repornire de telefon. -->
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"/>
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
