.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Platforme regenerate automat de flutter, dar nefolosite in acest proiect
# (vezi commit-ul "Elimina folderele de platforma nefolosite") - se recreeaza
# la orice "flutter create"/build, nu trebuie sa reintre in istoric.
/ios/
/macos/
/linux/
/windows/

# Cheia de cont de serviciu Firebase (vezi tools/purge_accounts.py) —
# echivalentul unei parole de administrator peste tot proiectul.
tools/service-account.json

# Copii identice ale play_store/capturi/, facute doar ca sa fie la indemana
# cand se incarca in Play Console la cele doua campuri de tableta. Aceleasi
# bytes, deci nu are rost sa stea de doua ori in istoric — vezi nota din
# play_store/listare.md.
play_store/capturi_tableta/

# artefacte Playwright din verificarile pe browser
.playwright-mcp/

# Dependintele Cloud Functions — se refac cu `npm install` in functions/,
# n-au ce cauta in repo (5600 de fisiere, ~875k linii).
functions/node_modules/

# Testele de reguli isi instaleaza singure dependentele in test/ (vezi
# test/README-reguli.md) si copiaza acolo firestore.rules ca sa-l vada
# emulatorul. Nimic din astea nu e sursa — sursa regulilor e in radacina.
test/node_modules/
test/package.json
test/package-lock.json
test/firestore.rules
