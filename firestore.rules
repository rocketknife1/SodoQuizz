rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Un cont Guest ABANDONAT SI COMPLET GOL, singurul fel de cont pe care
    // orice jucator autentificat are voie sa-l stearga (vezi
    // PlayerProfileService._sweepStaleGuests — fara Cloud Functions in acest
    // proiect, curatarea o fac clientii activi, oportunist).
    //
    // Adevarul se citeste din profilul public, singurul document vizibil
    // tuturor. Conditiile, toate obligatorii:
    //   - fara cont Google legat (hasGoogleAccount). Inainte semnul era
    //     "nu exista users/{uid}" — nu mai merge, fiindca de acum urca si
    //     Guest-ii progresul acolo (vezi CloudSyncService);
    //   - zero meciuri multiplayer jucate vreodata;
    //   - zero semne de activitate (activityEvents: roata invartita, balanta
    //     miscata — vezi StorageService). E de ajuns UNUL ca sa fie pastrat
    //     definitiv: a pierde un jucator real e mult mai scump decat un
    //     document ramas degeaba in baza;
    //   - neatins de 15+ zile.
    // Pragurile trebuie tinute in sincron cu guestSweepInactivity din
    // player_profile_service.dart.
    function isSweepableGuest(uid) {
      let p = get(/databases/$(database)/documents/player_profiles/$(uid));
      return p != null
        && p.data.get('hasGoogleAccount', false) == false
        && p.data.get('matchesPlayed', 0) == 0
        && p.data.get('activityEvents', 0) == 0
        && p.data.lastActive is timestamp
        && request.time > p.data.lastActive + duration.value(15, 'd');
    }

    // Cloud-save profil (XP, monede, progres) — doar propriul cont
    // (Google sau anonim) poate citi/scrie propriul document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Adminul poate CITI si STERGE salvarea din cloud a oricui.
      //
      // Stergerea e ceruta de actiunea "Sterge complet" din AdminScreen (vezi
      // PlayerProfileService.purgePlayer). Citirea a fost adaugata deliberat
      // pe 3 august 2026, ca ecranul de detaliu al unui jucator sa poata
      // arata balanta reala (monede/gems/inimi/hints) si nivelul — fara ea,
      // un "mi-au disparut monedele" sau o suspiciune de trisare nu se pot
      // verifica in niciun fel.
      //
      // Ce contine documentul, ca decizia sa fie judecabila: doar progres de
      // joc si setari (coins, gems, hints_balance, lives, xp, high_score,
      // streak, quests, music_enabled, display_name). Fara email, fara
      // locatie, fara mesaje. Emailul exista doar in Firebase Auth.
      //
      // ATENTIE la lucrul care NU se schimba: ceilalti jucatori tot NU pot
      // citi documentul. Se largeste strict pentru un singur email, care are
      // deja drept de ban/stergere/grant peste tot in fisierul asta.
      //
      // Alternativa respinsa: oglindirea balantei in player_profiles ar fi
      // facut-o vizibila TUTUROR jucatorilor, deci strict mai rau.
      allow read, delete: if request.auth != null && request.auth.token.email == 'dragosssx@gmail.com';

      // Curatarea Guest-ilor abandonati sterge AMANDOUA documentele contului
      // (profilul public + asta) intr-un singur batch — de cand urca si
      // Guest-ii progresul aici, fara regula asta ar fi ramas in urma lor
      // cloud-save-uri orfane, imposibil de sters de altcineva decat de
      // proprietarul care nu mai vine niciodata.
      //
      // Conditiile sunt exact aceleasi ca la stergerea profilului public si
      // se verifica pe ACELA, nu aici (documentul asta nu contine nimic
      // despre activitate/vechime). Costa un read in plus la evaluare, dar
      // se intampla doar la maturare, deci practic niciodata.
      allow delete: if request.auth != null && isSweepableGuest(uid);
    }

    // Meciuri multiplayer — orice cont autentificat (inclusiv anonim,
    // vezi MultiplayerService.ensureInitialized) poate participa. Nu se
    // poate restrânge la request.auth.uid == playerId fără Cloud
    // Functions, pentru că liderul care formează un meci de matchmaking
    // scrie playeri/scoruri și în documentele altor candidați
    // (attemptFormMatch în multiplayer_service.dart).
    match /matches/{matchId} {
      allow read, create, update, delete: if request.auth != null;

      match /players/{playerId} {
        allow read, write: if request.auth != null;
      }

      match /chat/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
        // necesar la curatarea meciului cand ultimul jucator pleaca (vezi
        // MultiplayerService._deleteMatch) - fara asta, stergerea esua cu
        // permission-denied si userul ramanea blocat, fara sa poata iesi.
        allow delete: if request.auth != null;
      }
    }

    // Coada de matchmaking — aceeași observație: formarea meciului scrie
    // `matchId` în documentele altor jucători din coadă.
    match /matchmaking_queue/{queueId} {
      allow read, write: if request.auth != null;
    }

    // Cererea de revanșă de la finalul unui meci (vezi
    // MultiplayerService.offerRematch + RematchOffer) — id-ul documentului e
    // chiar matchId-ul meciului tocmai încheiat, singurul id pe care toți
    // foștii participanți îl cunosc deja (fiecare are deschis ecranul de
    // rezultate cu el), fără niciun canal de invitație separat. Aceeași
    // observație ca la `matches` mai sus: gazda scrie camera nouă cu jucători
    // aleși de EA (launchRematch), deci nu se poate restrânge la
    // request.auth.uid fără Cloud Functions.
    match /rematch_offers/{matchId} {
      allow read, write: if request.auth != null;
    }

    // Oferta de meci formată de sistem la Meci Rapid (vezi
    // MultiplayerService.attemptFormMatch + QuickMatchOffer) — jucătorii
    // trebuie să confirme explicit înainte să înceapă meciul, nu mai sunt
    // aruncați direct în joc. Același motiv ca la `rematch_offers`: unul
    // dintre cei doi scrie camera nouă (launchQuickMatch) pentru AMÂNDOI,
    // deci nu se poate restrânge la request.auth.uid fără Cloud Functions.
    match /quickmatch_offers/{offerId} {
      allow read, write: if request.auth != null;
    }

    // "Cineva tocmai a intrat in Multiplayer" — un document per jucator,
    // rescris la fiecare intrare (vezi MultiplayerPresenceService). Din el
    // se face anuntul scurt care apare pe ecran tuturor, ca cei care ar
    // vrea sa joace sa nimereasca aceeasi fereastra de timp.
    //
    // CITIREA E PUBLICA (orice cont autentificat) fiindca exact asta e
    // rostul: sa vada ceilalti. Documentul contine strict numele afisat si
    // poza de profil, adica lucruri deja vizibile in leaderboard.
    //
    // SCRIEREA E STRICT PE PROPRIUL DOCUMENT: fara conditia pe uid, un
    // client modificat ar fi putut anunta in numele altcuiva — adica sa
    // trimita jocului intreg notificari false, semnate cu numele unui om
    // care nici macar nu deschisese aplicatia.
    match /multiplayer_presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      // adminul, la stergerea completa a unui cont (purgePlayer) — altfel ar
      // fi ramas un anunt orfan cu numele unui cont care nu mai exista.
      allow delete: if request.auth != null && request.auth.token.email == 'dragosssx@gmail.com';
    }

    // Profil public (leaderboard global, ligă, statistici) — spre
    // deosebire de users/{uid} de mai sus, citirea e publică (orice cont
    // autentificat, inclusiv anonim, trebuie să poată vedea leaderboard-ul
    // altora), dar scrierea rămâne strict pe propriul doc (vezi
    // PlayerProfileService — fiecare client își scrie doar propriul
    // rezultat, fără Cloud Functions în acest proiect).
    match /player_profiles/{uid} {
      allow read: if request.auth != null;

      // Scriere normala: doar propriul owner, si doar daca nu e banat (vezi
      // banned_players mai jos - fara asta, un cont banat si-ar putea
      // recrea singur profilul la urmatorul heartbeat, vezi
      // PlayerProfileService.ensureProfileHeartbeat). A doua conditie
      // (emailul de admin) da acces total de scriere/stergere pe ORICE
      // profil - foloseste pentru actiunea de ban din AdminScreen
      // (PlayerProfileService.banPlayer) si pentru grant-urile de resurse.
      allow write: if request.auth != null
        && !exists(/databases/$(database)/documents/banned_players/$(uid))
        && (request.auth.uid == uid || request.auth.token.email == 'dragosssx@gmail.com');

      // Curatare Guest abandonati (vezi PlayerProfileService._sweepStaleGuests
      // - fara Cloud Functions in acest proiect, orice client autentificat
      // face treaba, oportunist, la citirea leaderboard-ului). Conditiile
      // sunt cele din isSweepableGuest() de la inceputul fisierului, scrise
      // aici pe `resource.data` (documentul se sterge chiar pe el insusi,
      // deci nu mai e nevoie de un get() in plus).
      allow delete: if request.auth != null
        && resource.data.get('hasGoogleAccount', false) == false
        && resource.data.get('matchesPlayed', 0) == 0
        && resource.data.get('activityEvents', 0) == 0
        && resource.data.lastActive is timestamp
        && request.time > resource.data.lastActive + duration.value(15, 'd');

      // Cereri de prietenie primite — un doc per expeditor (id = uid-ul lui).
      // Citire/ștergere permisă fie owner-ului (uid, care le primește), fie
      // expeditorului însuși (fromUid, care poate verifica/anula propria
      // cerere trimisă) — creare doar de către expeditor.
      match /friend_requests/{fromUid} {
        allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid == fromUid);
        allow create: if request.auth != null && request.auth.uid == fromUid;
        // adminul are nevoie sa le citeasca/stearga la stergerea completa a
        // unui cont (purgePlayer), altfel raman cereri orfane in urma lui.
        allow read, delete: if request.auth != null && request.auth.token.email == 'dragosssx@gmail.com';
        allow delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == fromUid);
      }

      // Jucatorii blocati de proprietarul acestui profil (vezi
      // ModerationService). Lista e STRICT personala: nimeni altcineva nu are
      // ce cauta in ea, nici macar cel blocat — mai ales el, de fapt. Blocarea
      // nu-l anunta si nu-l impiedica sa scrie mai departe pentru ceilalti; ii
      // ascunde mesajele doar celui care a apasat butonul, la afisare.
      //
      // Adminul primeste read+delete separat, ca sa poata curata subcolectia
      // la "Sterge complet" (vezi PlayerProfileService.purgePlayer): in
      // Firestore documentele-copil NU dispar odata cu parintele, deci fara
      // regula asta ar fi ramas atarnate sub un profil inexistent.
      match /blocked/{blockedUid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
        allow read, delete: if request.auth != null && request.auth.token.email == 'dragosssx@gmail.com';
      }

      // "Cutia postala" de anunturi scrise de admin (vezi
      // NotificationService.pullFromCloud) — acelasi tipar ca admin_grants de
      // mai jos: adminul scrie, proprietarul citeste si sterge dupa ce le-a
      // copiat pe telefon.
      //
      // DE CE E O SUBCOLECTIE PER JUCATOR, si nu o colectie publica de
      // anunturi: un anunt e adesea personal ("ti-am dat inapoi monedele
      // pierdute"), iar o colectie citibila de toata lumea ar fi facut
      // mesajele fiecaruia vizibile tuturor. Costa mai multe scrieri la un
      // anunt global (unul per jucator, vezi broadcastNotification), dar nu
      // deschide nimic la citire.
      //
      // Jucatorul NU are voie sa scrie aici: altfel un client modificat si-ar
      // fi putut fabrica singur "anunturi oficiale".
      match /notifications/{notificationId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        // adminul: scrie anunturile si le curata la "Sterge complet"
        // (purgePlayer) — in Firestore documentele-copil nu dispar odata cu
        // profilul parinte.
        allow read, write: if request.auth != null && request.auth.token.email == 'dragosssx@gmail.com';
        // un prieten poate lasa o notificare in cutia mea — azi doar "te-am
        // depasit in liga" (vezi PlayerProfileService._notifyOvertakes,
        // PLAN_DE_VIITOR.md punctul 1). Doar CREATE, niciodata update/delete
        // (nu poate rescrie sau sterge ce a scris deja), si doar daca e deja
        // prieten ACCEPTAT cu proprietarul cutiei (relatie mutuala, vezi
        // /friends mai jos) — un strain nu poate trimite nimic aici.
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/player_profiles/$(uid)/friends/$(request.auth.uid));
      }

      // Prieteni acceptați — relație mutuală, câte un doc-oglindă pe fiecare
      // parte (player_profiles/A/friends/B ȘI player_profiles/B/friends/A).
      // La acceptare, oricare din cei doi trebuie să poată scrie AMBELE
      // documente într-un singur batch — de-aia scrierea e permisă oricăruia
      // din cei doi uid-uri implicate (owner SAU friendUid), nu doar owner-ului.
      match /friends/{friendUid} {
        allow read: if request.auth != null;
        // a treia varianta: adminul, ca sa poata rupe legaturile de prietenie
        // in ambele sensuri cand sterge complet un cont (purgePlayer).
        allow write: if request.auth != null
          && (request.auth.uid == uid
              || request.auth.uid == friendUid
              || request.auth.token.email == 'dragosssx@gmail.com');
      }
    }

    // Un doc per meci multiplayer ÎNCHEIAT NORMAL (vezi
    // PlayerProfileService.recordCompletedMatch) — spre deosebire de
    // matches/{matchId} de mai sus (șters când ultimul jucător pleacă),
    // ăsta rămâne definitiv, ca sursă reală pentru "câte meciuri au fost
    // jucate" (AdminScreen, tab Statistici — .count() agregat pe server).
    // Orice jucător autentificat poate scrie (id-ul document-ului = matchId,
    // deci scrierile mai multor jucători pentru același meci converg,
    // merge:true, nu se dublează) — doar admin-ul citește/agregă.
    match /completed_matches/{matchId} {
      allow read: if request.auth != null && request.auth.token.email == 'dragosssx@gmail.com';
      // Scrierea ramane deschisa oricui e autentificat (id-ul doc = matchId,
      // deci scrierile jucatorilor de la aceeasi masa converg, merge:true),
      // DAR continutul e verificat: exact cele 3 campuri asteptate, cu
      // tipurile lor si playerCount >= 2 (vezi recordCompletedMatch). Fara
      // asta, oricine putea scrie un doc fals sub un matchId inventat si
      // umfla numaratoarea din AdminScreen. Fara delete: statistica e
      // definitiva, nimeni n-o poate subtia.
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['gameModeId', 'playerCount', 'finishedAt'])
        && request.resource.data.gameModeId is string
        && request.resource.data.playerCount is int
        && request.resource.data.playerCount >= 2;
    }

    // Jurnalul camerelor terminate, cu tabloul complet al mesei (cine a jucat,
    // cu ce a intrat, cu ce a iesit) — vezi MultiplayerActivityService.
    // Se autodistruge dupa 10 minute; `completed_matches` de mai sus ramane
    // definitiv, fiindca el e sursa pentru "cate meciuri s-au jucat".
    match /multiplayer_activity/{matchId} {
      // Citirea (deci si listarea) e strict a adminului: documentul contine
      // cati bani a pus si a luat fiecare. Participantii vad oricum datele
      // astea in timpul meciului, dar nu au de ce sa vada mesele altora.
      allow read: if request.auth != null && request.auth.token.email == 'dragosssx@gmail.com';

      // Scrierea: orice jucator autentificat, la finalul propriului meci.
      // Id-ul documentului = matchId, deci scrierile tuturor jucatorilor de
      // la aceeasi masa converg in acelasi document (merge:true).
      // ATENTIE: "create, update", NU "write" — in Firestore `write` include
      // si delete, iar asta ar fi permis oricui sa stearga orice camera.
      allow create, update: if request.auth != null;

      // Stergere: fie adminul (matura din tab-ul Camere ce a ramas de la
      // jucatori care n-au mai deschis aplicatia), fie ORICINE, dar numai
      // dupa ce a trecut termenul — asa isi poate curata fiecare client
      // camerele proprii, tintit dupa id, fara sa aiba drept de citire
      // (vezi MultiplayerActivityService.sweepMine). Conditia pe expiresAt e
      // verificata pe server, deci o camera inca activa nu poate fi stearsa
      // de nimeni, oricat ar incerca un client modificat.
      allow delete: if request.auth != null
        && (request.auth.token.email == 'dragosssx@gmail.com'
            || (resource.data.expiresAt is timestamp && request.time > resource.data.expiresAt));
    }

    // Raportarile trimise de jucatori (vezi ModerationService.submitReport).
    //
    // Scrie oricine, dar numai in numele lui: conditia pe reporterUid opreste
    // un client modificat sa fabrice reclamatii semnate cu numele altcuiva —
    // altfel raportarea ar fi devenit ea insasi o unealta de harassment.
    //
    // CITIREA E DOAR A ADMINULUI, si asta conteaza: documentul contine
    // mesajul reclamat si numele celui care a raportat. Daca l-ar putea citi
    // oricine, "cine m-a reclamat" ar fi la un tap distanta, iar butonul de
    // raportare ar deveni periculos de folosit.
    //
    // Fara update pentru jucatori: o raportare trimisa nu se mai poate
    // rescrie, nici de cel care a trimis-o.
    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'dragosssx@gmail.com';
    }

    // Raportarile de intrebari (vezi QuestionReportService.submitReport) —
    // aceleasi reguli ca la /reports: oricine scrie doar in numele lui,
    // doar adminul citeste/sterge.
    match /question_reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'dragosssx@gmail.com';
    }

    // Chat privat intre doi prieteni (vezi FriendChatService) — separat de
    // chatul din camera multiplayer, care ramane sub matches/{matchId}/chat.
    //
    // Toata securitatea sta in NUMELE documentului: cele doua uid-uri,
    // sortate alfabetic, lipite cu "_". Regula despica id-ul inapoi si cere ca
    // cel care intra sa fie una din cele doua bucati. Merge fiindca uid-urile
    // Firebase sunt alfanumerice, fara "_" in ele, deci despicarea da exact
    // doua bucati, iar sortarea face ca acelasi fir sa aiba acelasi nume
    // indiferent cine scrie primul.
    //
    // De ce nu se verifica si prietenia: ar cere un get() in plus la FIECARE
    // mesaj citit sau scris. Ecranul se deschide oricum doar din lista de
    // prieteni, iar cel mai rau caz posibil e ca doi oameni care s-au scos din
    // prieteni sa-si mai poata scrie — firul e tot al lor, nu se scurge nimic
    // catre altcineva.
    match /friend_chats/{threadId} {
      function isParticipant() {
        return request.auth != null && request.auth.uid in threadId.split('_');
      }

      allow read, create, update: if isParticipant();
      // stergerea: participantii (la stergerea propriului cont, vezi
      // FriendChatService.deleteThreadWith) sau adminul, la "Sterge complet".
      allow delete: if isParticipant()
        || (request.auth != null && request.auth.token.email == 'dragosssx@gmail.com');

      match /messages/{messageId} {
        allow read: if isParticipant();
        // acelasi tipar ca la chatul din camera: poti scrie doar in numele tau.
        allow create: if isParticipant() && request.resource.data.senderId == request.auth.uid;
        allow delete: if isParticipant()
          || (request.auth != null && request.auth.token.email == 'dragosssx@gmail.com');
      }
    }

    // Conturi banate de admin (vezi PlayerProfileService.banPlayer) — un doc
    // = uid-ul nu mai are voie sa scrie player_profiles/{uid} (vezi
    // conditia exists() de mai sus). Doar admin-ul citeste/scrie; nimeni
    // altcineva nu are nevoie sa acceseze asta direct (verificarea exists()
    // din regula de mai sus are acces implicit, indiferent de allow read).
    match /banned_players/{uid} {
      allow read, write: if request.auth != null && request.auth.token.email == 'dragosssx@gmail.com';
    }

    // "Cutie postala" de la admin catre un jucator anume (vezi
    // CloudSyncService.consumePendingGrant): resurse trimise si/sau cererea
    // de reset a contului. Merge pentru ORICINE, Guest inclusiv — cutia e
    // legata de uid, iar un Guest are uid (anonim) de la prima pornire.
    // Admin-ul creeaza/actualizeaza continutul; owner-ul (uid) doar citeste
    // si sterge, la consum - nu poate scrie/crea unul singur.
    match /admin_grants/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.token.email == 'dragosssx@gmail.com';
    }

    // Coada de conturi de sters din Firebase Authentication (vezi
    // PlayerProfileService.purgePlayer + tools/purge_accounts.py).
    //
    // De ce exista: un client NU poate sterge contul Auth al altcuiva —
    // operatia cere Admin SDK, iar proiectul e pe planul gratuit, fara Cloud
    // Functions. Cand adminul sterge un jucator, datele din Firestore dispar
    // pe loc (asta se poate din aplicatie), iar uid-ul ramane notat aici;
    // scriptul de intretinere sterge apoi contul din Auth si goleste coada.
    // Pana atunci, contul ramas in Auth e inert — nu mai are nicio data
    // legata de el si nu apare nicaieri in joc.
    match /pending_auth_deletions/{uid} {
      allow read, write: if request.auth != null && request.auth.token.email == 'dragosssx@gmail.com';
    }

    // Orice altceva neenumerat explicit mai sus — refuzat implicit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
