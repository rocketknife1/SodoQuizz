rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cloud-save profil (XP, monede, progres) — doar propriul cont
    // (Google sau anonim) poate citi/scrie propriul document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Meciuri multiplayer — orice cont autentificat (inclusiv anonim,
    // vezi MultiplayerService.ensureInitialized) poate participa. Nu se
    // poate restrânge la request.auth.uid == playerId fără Cloud
    // Functions, pentru că liderul care formează un meci de matchmaking
    // scrie playeri/scoruri și în documentele altor candidați
    // (attemptFormMatch în multiplayer_service.dart).
    match /matches/{matchId} {
      allow read, create, update, delete: if request.auth != null;

      match /players/{playerId} {
        allow read, write: if request.auth != null;
      }

      match /chat/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      }
    }

    // Coada de matchmaking — aceeași observație: formarea meciului scrie
    // `matchId` în documentele altor jucători din coadă.
    match /matchmaking_queue/{queueId} {
      allow read, write: if request.auth != null;
    }

    // Orice altceva neenumerat explicit mai sus — refuzat implicit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
